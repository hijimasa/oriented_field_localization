<?xml version="1.0"?>
<!-- 評価用の差動二輪ロボット。
     LiDAR は base_link と xy が一致する位置に置いてある。位置推定が返すのは
     スキャン原点の姿勢なので、センサをずらすと ground truth (base_link) との
     間に系統的なオフセットが乗って評価が濁るため。 -->
<robot name="ofl_bot">
  <!-- root は base_link。慣性を持たない root リンク (base_footprint) を置くと
       Gazebo の URDF -> SDF 変換で弾かれるので使わない。 -->
  <link name="base_link">
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.14" iyz="0" izz="0.18"/>
    </inertial>
    <collision><geometry><box size="0.40 0.34 0.16"/></geometry></collision>
    <visual><geometry><box size="0.40 0.34 0.16"/></geometry>
      <material name="body"><color rgba="0.2 0.4 0.8 1"/></material></visual>
  </link>
  <link name="left_wheel">
    <inertial><mass value="0.5"/>
      <inertia ixx="0.0011" ixy="0" ixz="0" iyy="0.0011" iyz="0" izz="0.0016"/></inertial>
    <collision><origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry></collision>
    <visual><origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry></visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.16 -0.02"/><axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <inertial><mass value="0.5"/>
      <inertia ixx="0.0011" ixy="0" ixz="0" iyy="0.0011" iyz="0" izz="0.0016"/></inertial>
    <collision><origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry></collision>
    <visual><origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry></visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.16 -0.02"/><axis xyz="0 1 0"/>
  </joint>

  <link name="caster">
    <inertial><mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    <collision><geometry><sphere radius="0.04"/></geometry></collision>
    <visual><geometry><sphere radius="0.04"/></geometry></visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/>
    <origin xyz="-0.15 0 -0.06"/>
  </joint>

  <link name="laser_link">
    <inertial><mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    <visual><geometry><cylinder radius="0.04" length="0.05"/></geometry></visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/>
    <origin xyz="0 0 0.13"/>
  </joint>

  <gazebo reference="caster">
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <!-- 車輪エンコーダ由来のオドメトリ (odometry_source=0)。
       スリップで実際にドリフトするので、TRACK の事前姿勢の質が現実的になる。 -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.32</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>1.5</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odometry_source>0</odometry_source>
    </plugin>
  </gazebo>

  <!-- 真値 (評価専用。位置推定には渡さない) -->
  <gazebo>
    <plugin name="p3d" filename="libgazebo_ros_p3d.so">
      <ros><namespace>/</namespace><remapping>odom:=ground_truth</remapping></ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <!-- 記録は 20 Hz だが、真値が 20 Hz だと最大 50 ms 古い真値と比べることに
           なり、0.5 m/s では 0.025 m の見かけの誤差が乗る (誤差の測定下限が
           推定そのものの誤差と同じ桁になってしまう)。50 Hz にして下限を
           0.01 m へ下げる。 -->
      <update_rate>50.0</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan><horizontal>
          <samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159265</min_angle><max_angle>3.13285</max_angle>
        </horizontal></scan>
        <range><min>0.15</min><max>10.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/</namespace><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
